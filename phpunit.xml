<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="boa-api">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src/data_handlers</directory>
        </include>
    </source>
    <php>
        <!-- Prefer compose MYSQL_* when boa-api is up; used by DbalAdapterTest. -->
        <env name="MYSQL_HOST" value="mysql" force="false"/>
    </php>
</phpunit>
